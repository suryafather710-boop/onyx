<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>ONYX — Precision-Built Digital Experiences</title>
  <meta name="description" content="ONYX is a next-gen digital studio crafting immersive websites, brand systems, UI/UX, and growth engines for ambitious brands. Founder-led, globally available." />
  <meta name="theme-color" content="#060608" />
  <meta name="author" content="Suryanshu — ONYX" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ONYX" />
  <meta property="og:title" content="ONYX — Precision-Built Digital Experiences" />
  <meta property="og:description" content="A next-gen digital studio crafting immersive web, brand systems, UI/UX, and growth. Founder-led by Suryanshu." />
  <meta property="og:url" content="<%= site.url %>" />
  <meta property="og:image" content="<%= site.url %>/images/og-cover.svg" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="ONYX — Precision-Built Digital Experiences" />
  <meta name="twitter:description" content="A next-gen digital studio crafting immersive web, brand systems, UI/UX, and growth." />
  <meta name="twitter:image" content="<%= site.url %>/images/og-cover.svg" />

  <link rel="canonical" href="<%= site.url %>" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/sections.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/footer.css" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ONYX",
      "url": "<%= site.url %>",
      "email": "<%= site.email %>",
      "founder": { "@type": "Person", "name": "Suryanshu" },
      "foundingDate": "2024",
      "slogan": "We build brands that lead.",
      "description": "A next-gen digital studio crafting immersive web, brand systems, UI/UX, and growth."
    }
  </script>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <%- include('partials/preloader') %>

  <!-- 1. Cookie banner -->
  <div class="cookie" id="cookie" role="dialog" aria-live="polite" aria-label="Cookie notice" hidden>
    <p class="cookie__text">We use only essential local storage to remember your preferences — no tracking or advertising cookies. <a href="/cookies" class="cookie__link">Learn more</a>.</p>
    <div class="cookie__actions">
      <button class="cookie__btn cookie__btn--accept" id="cookieAccept">Accept</button>
      <button class="cookie__btn cookie__btn--decline" id="cookieDecline">Decline</button>
    </div>
  </div>

  <%- include('partials/nav') %>

  <main id="main">
    <!-- 4. Hero — full-bleed key visual -->
    <section class="hero" id="home">
      <!-- Accessible heading: the wordmark + copy live inside the image, so mirror
           them here for screen readers and SEO. -->
      <h1 class="sr-only">ONYX — ONYX designs immersive websites, sharp brand systems, and growth engines that turn first impressions into lasting momentum.</h1>

      <div class="hero__media reveal" data-hero-media>
        <img
          class="hero__img"
          id="heroImg"
          src="/images/hero-onyx-plate.png"
          alt="A hand holding a phone in front of a giant glowing ONYX wordmark on a red backdrop"
          onerror="this.onerror=null; this.src='/images/hero-onyx.svg';"
        />
      </div>

      <!-- Live text rebuilt over the plate (the image keeps the ONYX wordmark);
           decorative here because the sr-only h1 above carries the real copy. -->
      <div class="hero__text" aria-hidden="true">
        <span class="hero__eyebrow reveal"><% 'PRESENTING'.split('').forEach(function (ch, i) { %><span class="h-char" style="--i: <%= i %>"><%= ch %></span><% }); %></span>
        <p class="hero__para reveal">
          <% 'ONYX designs immersive websites, sharp brand systems, and growth engines that turn first impressions into lasting momentum.'.split(' ').forEach(function (w, i) { %><span class="h-word<%= i === 0 ? ' h-word--lead' : '' %>" style="--i: <%= i %>"><%= w %></span> <% }); %>
        </p>
      </div>

      <a class="hero__scroll" href="#philosophy" data-scroll aria-label="Scroll down">
        <span class="hero__scroll-label">Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- 5. Philosophy quote — word-by-word scroll reveal -->
    <section class="philosophy" id="philosophy">
      <div class="philosophy__scroller" data-text-reveal>
        <div class="philosophy__sticky">
          <blockquote class="philosophy__quote" data-reveal-text>"We don't just build websites — we engineer the moment a visitor becomes a believer."</blockquote>
          <p class="philosophy__support" data-reveal-text>Craft over noise. Precision over trend. Every pixel and every millisecond is a decision made in service of the people who use what we make.</p>
          <span class="philosophy__mark" aria-hidden="true">ONYX</span>
        </div>
      </div>
    </section>

    <!-- 6. Built-with logo cloud -->
    <% const techs = [
      { name: 'Claude', color: '#d97757', mark: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.6l1.7 6.9 5-5-2.6 6.6 6.9-1.7-6 3.6 6 3.6-6.9-1.7 2.6 6.6-5-5L12 22.4l-1.7-6.9-5 5 2.6-6.6L1 15.6l6-3.6-6-3.6 6.9 1.7L5.3 3.5l5 5z"/></svg>' },
      { name: 'Node.js', color: '#8cc84b', mark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.2l8.5 4.9v9.8L12 21.8l-8.5-4.9V7.1z"/></svg>' },
      { name: 'Express', color: '#e9e6dd', mark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>' },
      { name: 'EJS', color: '#e5b640', mark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6"/></svg>' },
      { name: 'GSAP', color: '#0ae448', mark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 15c3.5 0 5-6 9-6s3.5 6 9 6"/></svg>' },
      { name: 'Lenis', color: '#7fb4ff', mark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M2 12c2.2-4.4 4.4-4.4 6.6 0s4.4 4.4 6.6 0 4.4-4.4 6.8 0"/></svg>' },
      { name: 'JavaScript', color: '#f7df1e', mark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/></svg>' }
    ]; %>
    <section class="techcloud" aria-label="Built with">
      <div class="container techcloud__head">
        <h2 class="techcloud__title reveal">
          <% 'Built with the tools behind the work'.split(' ').forEach(function (w, i) { %><span class="tc-word" style="--wi: <%= i %>"><%= w %></span> <% }); %>
        </h2>
        <p class="techcloud__desc reveal">Every pixel of ONYX is hand-built on a modern, no-shortcut stack — and shipped with Claude as our build partner.</p>
      </div>

      <div class="techcloud__marquee" data-marquee>
        <div class="techcloud__track">
          <% for (let rep = 0; rep < 2; rep++) { %>
          <div class="techcloud__group" <%= rep === 1 ? 'aria-hidden="true"' : '' %>>
            <% techs.forEach(function (t) { %>
            <span class="tc-logo" style="color: <%= t.color %>">
              <span class="tc-logo__mark"><%- t.mark %></span>
              <span class="tc-logo__name"><%= t.name %></span>
            </span>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- 6b. Brand portal — image zooms in on scroll -->
    <section class="portal" id="brandportal" aria-label="We build brands that lead">
      <div class="portal__stage">
        <img
          class="portal__img"
          src="/images/brand-leads.png"
          onerror="this.onerror=null; this.src='/images/brand-leads.svg';"
          alt="We build brands that lead"
        />
        <div class="portal__scrim" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 10. Services — sticky content scroll -->
    <% const services = [
      { n: '01', t: 'Web Design & Development', img: 'service-web', photo: true,
        p: ['Immersive, fast, hand-built sites that feel inevitable — from first concept to a production codebase.',
            'You own what we ship: clean, documented code built to scale with you, not lock you in.'],
        list: ['Design systems & interface', 'Production build & CMS', 'Performance & SEO baked in'] },
      { n: '02', t: 'Branding & Identity', img: 'service-brand', photo: true,
        p: ['Names, marks, and systems with a spine — identities that stay sharp across every surface and scale.',
            'Brand work that gives you a point of view, not just a logo, and holds up as you grow.'],
        list: ['Naming & positioning', 'Logo, type & colour system', 'Brand guidelines'] },
      { n: '03', t: 'UI & UX Design', img: 'service-uiux', photo: true,
        p: ['Interfaces engineered around real behaviour — intuitive, accessible, and quietly delightful to use.',
            'We prototype, test, and refine until the product feels effortless, then hand it over pixel-perfect.'],
        list: ['Research & user flows', 'Prototyping & testing', 'Pixel-perfect handoff'] },
      { n: '04', t: 'Growth & Automation', img: 'service-growth', photo: false,
        p: ['Funnels, analytics, and automations that turn a strong launch into compounding momentum.',
            'Measurable systems that keep working after go-live — so growth is engineered, not hoped for.'],
        list: ['Funnels & landing pages', 'Analytics & tracking', 'Automations & CRM'] }
    ]; %>
    <section class="stsvc" id="services">
      <div class="stsvc__sticky">
        <div class="stsvc__head">
          <span class="section-label">Capabilities</span>
          <h2 class="stsvc__title">Our Services</h2>
        </div>

        <% services.forEach(function (s) { %>
        <div class="stsvc__row">
          <div class="stsvc__text" data-content>
            <span class="stsvc__num"><%= s.n %></span>
            <h3 class="stsvc__heading"><%= s.t %></h3>
            <% s.p.forEach(function (para) { %><p class="stsvc__p"><%= para %></p><% }); %>
            <ul class="stsvc__list">
              <% s.list.forEach(function (li) { %><li><%= li %></li><% }); %>
            </ul>
            <a class="stsvc__link" href="#contact">
              <span class="stsvc__link-text">Start a project</span>
              <svg class="stsvc__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <div class="stsvc__media" data-image>
            <% if (s.photo) { %>
            <img src="/images/<%= s.img %>.jpg"
                 onerror="this.onerror=null;this.src='/images/<%= s.img %>.svg'"
                 alt="<%= s.t %>" loading="lazy" />
            <% } else { %>
            <img src="/images/<%= s.img %>.svg" alt="<%= s.t %>" loading="lazy" />
            <% } %>
          </div>
        </div>
        <% }); %>

        <div class="stsvc__scroll" aria-hidden="true">
          <span>Scroll</span>
          <svg viewBox="0 0 20 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polyline class="stsvc__chev stsvc__chev--1" points="2,2 10,9 18,2" />
            <polyline class="stsvc__chev stsvc__chev--2" points="2,10 10,17 18,10" />
            <polyline class="stsvc__chev stsvc__chev--3" points="2,18 10,25 18,18" />
          </svg>
        </div>
      </div>
    </section>

    <!-- 11. Process — horizontal feature reveal -->
    <% const proc = [
      { n: '01', t: 'Discovery', p: ['We start by listening — a deep dive into your goals, audience and market to understand what success actually looks like.', 'No assumptions, just research and the questions that surface the problem worth solving.'] },
      { n: '02', t: 'Strategy', p: ['We turn insight into a plan: positioning, structure and priorities mapped before a single pixel is drawn.', 'A blueprint everyone aligns on, so the build is deliberate — never guesswork.'] },
      { n: '03', t: 'Design', p: ['Craft meets systems. We design interfaces and identity that are beautiful, consistent and built to scale.', 'Every detail is considered, tested and refined until it feels effortless.'] },
      { n: '04', t: 'Build', p: ['Hand-built, performant code — engineered for speed, accessibility and long-term maintainability.', 'You own what we ship: clean, documented, and ready to grow with you.'] },
      { n: '05', t: 'Launch', p: ['We ship with confidence, then watch the numbers. Launch is a milestone, not the finish line.', 'Ongoing support and growth work keep the momentum compounding after go-live.'] }
    ]; %>
    <section class="hproc" id="process" aria-label="Our process">
      <div class="hproc__stage">
        <div class="hproc__head">
          <span class="section-label">How We Work</span>
          <h2 class="hproc__title">Our Process</h2>
        </div>

        <div class="hproc__track" id="hprocTrack">
          <% proc.forEach(function (s) { %>
          <article class="hproc__card">
            <div class="hproc__media">
              <span class="hproc__bignum" data-hproc-num aria-hidden="true"><%= s.n %></span>
            </div>
            <div class="hproc__text">
              <span class="hproc__num"><%= s.n %> — <%= String(proc.length).padStart(2, '0') %></span>
              <h3 class="hproc__name"><%= s.t %></h3>
              <div class="hproc__body">
                <% s.p.forEach(function (para) { %><p class="hproc__p"><%= para %></p><% }); %>
              </div>
            </div>
          </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- 8. How we work — honest, verifiable signals (no fabricated metrics) -->
    <section class="stats" aria-label="How ONYX works">
      <div class="container stats__grid">
        <div class="stat reveal">
          <span class="stat__num" data-count="24" data-suffix="h">0</span>
          <span class="stat__label">Reply within</span>
        </div>
        <div class="stat reveal">
          <span class="stat__num">Fixed</span>
          <span class="stat__label">Project pricing</span>
        </div>
        <div class="stat reveal">
          <span class="stat__num" data-count="100" data-suffix="%">0</span>
          <span class="stat__label">You own the code</span>
        </div>
        <div class="stat reveal">
          <span class="stat__num" data-count="2024" data-raw="true">0</span>
          <span class="stat__label">Founded</span>
        </div>
      </div>
    </section>

    <!-- 12. CTA banner -->
    <section class="cta-banner" aria-label="Start a project">
      <!-- Auralis: WebGL ambient background (noise + glow + grain). CSS gradient is the fallback. -->
      <canvas class="cta-banner__canvas" id="ctaCanvas" aria-hidden="true"></canvas>
      <div class="container cta-banner__inner">
        <h2 class="cta-banner__title reveal">Ready to Build Something Bold?</h2>
        <p class="cta-banner__sub reveal">Every standout brand started with a single decision to stop blending in.</p>
        <a href="#contact" class="btn btn--sweep reveal" data-scroll>Start Your Project <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- 13. Projects — 3D works wheel (ring -> drum, scroll-driven) -->
    <% const projects = [
      { n: '01', t: 'Aurora Commerce', tag: 'Web · Brand', img: 'work-01', d: 'A headless storefront rebuild that cut load times in half and lifted conversion for a growing DTC label. (Placeholder project — replace with real work.)' },
      { n: '02', t: 'Helix Studio', tag: 'Identity · UI', img: 'work-02', d: 'A full identity system and portfolio site for a creative studio, built to scale across future ventures. (Placeholder project — replace with real work.)' },
      { n: '03', t: 'Nimbus SaaS', tag: 'Product · UX', img: 'work-03', d: 'Onboarding and dashboard UX for an early-stage SaaS, designed to make a complex tool feel obvious. (Placeholder project — replace with real work.)' },
      { n: '04', t: 'Vertex Growth', tag: 'Growth · Automation', img: 'work-04', d: 'A conversion-focused landing system with analytics and automations wired in from day one. (Placeholder project — replace with real work.)' }
    ]; %>
    <section class="wheel" id="work" aria-label="Projects we've completed">
      <div class="wheel__head">
        <span class="section-label">Projects Delivered</span>
        <h2 class="wheel__heading">Projects We've Completed</h2>
      </div>

      <div class="wheel__pin" data-wheel-pin>
        <div class="wheel__ring" data-wheel-ring>
          <% projects.forEach(function (p, i) { %>
          <button class="wheel__card work-card" data-wheel-card
            data-project-index="<%= i %>"
            data-title="<%= p.t %>"
            data-tag="<%= p.tag %>"
            data-img="/images/<%= p.img %>.jpg"
            data-desc="<%= p.d %>"
            aria-label="<%= p.t %>">
            <span class="wheel__face" data-wheel-face>
              <img src="/images/<%= p.img %>.jpg"
                   onerror="this.onerror=null;this.src='/images/<%= p.img %>.svg'"
                   alt="<%= p.t %>" draggable="false" loading="eager" width="900" height="620" />
              <span class="wheel__cardname"><%= p.t %></span>
            </span>
          </button>
          <% }); %>
        </div>

        <div class="wheel__label" data-wheel-label aria-hidden="true">Our Work</div>
        <div class="wheel__title" data-wheel-title aria-hidden="true"></div>

        <ol class="wheel__index" data-wheel-index aria-hidden="true">
          <% projects.forEach(function (p, i) { %>
          <li><button type="button" data-wheel-jump="<%= i %>"><%= p.t %></button></li>
          <% }); %>
        </ol>
      </div>
    </section>

    <!-- Work lightbox -->
    <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Project details">
      <div class="lightbox__backdrop" data-lightbox-close></div>
      <div class="lightbox__panel">
        <button class="lightbox__close" id="lightboxClose" aria-label="Close project">✕</button>
        <div class="lightbox__media"><img id="lightboxImg" src="" alt=""
              onerror="this.onerror=null;this.src=this.src.replace('.jpg','.svg');" /></div>
        <div class="lightbox__body">
          <span class="lightbox__tag" id="lightboxTag"></span>
          <h3 class="lightbox__title" id="lightboxTitle"></h3>
          <p class="lightbox__desc" id="lightboxDesc"></p>
        </div>
      </div>
    </div>

    <!-- 13b. Core / About -->
    <section class="core" id="about">
      <div class="container core__inner">
        <span class="section-label reveal">Our Core</span>
        <h2 class="core__title" data-textblock data-block-color="#c9a84c">Websites that rank and convert.</h2>
        <div class="core__body">
          <p data-textblock data-block-color="#c9a84c">
            ONYX is a founder-led studio with a single focus: websites that win. Fast, immersive
            sites that make the right first impression — engineered so the details people feel are
            the same ones search engines reward.
          </p>
          <p data-textblock data-block-color="#c9a84c">
            Led by Suryanshu, who started ONYX at 17 with an unreasonable standard for craft. Every
            site is built to load fast, convert visitors, and climb search — because a beautiful site
            nobody can find isn't doing its job.
          </p>
        </div>
        <ul class="core__highlights reveal">
          <li>★ Website Design &amp; Build</li>
          <li>★ SEO Baked In</li>
          <li>★ Founder-Led — No Handoffs</li>
          <li>★ Est. 2024</li>
        </ul>
      </div>
    </section>

    <!-- 14b. Founder's Promise — trust block -->
    <section class="promise" id="promise" aria-label="The founder's promise">
      <div class="container promise__inner">
        <div class="promise__portrait reveal">
          <img src="/images/founder.jpg"
               onerror="this.onerror=null;this.src='/images/founder.svg'"
               alt="Suryanshu, founder of ONYX" loading="lazy" width="720" height="900" />
          <span class="promise__portrait-glow" aria-hidden="true"></span>
        </div>

        <div class="promise__body">
          <span class="section-label reveal">The Founder's Promise</span>
          <blockquote class="promise__quote reveal">
            <span class="promise__mark" aria-hidden="true">“</span>
            You work directly with me — never an account manager. You'll see the first
            concept before you commit a rupee or a dollar, and if it isn't right, you
            walk away. I only take on work I'd put my own name on.
          </blockquote>

          <ul class="promise__points reveal">
            <li><span aria-hidden="true">→</span> Work directly with the founder — no handoffs</li>
            <li><span aria-hidden="true">→</span> See the first concept before you pay</li>
            <li><span aria-hidden="true">→</span> Every message answered within 24 hours</li>
          </ul>

          <div class="promise__sign reveal">
            <span class="promise__signature">Suryanshu</span>
            <span class="promise__role">Founder, ONYX — building since 17</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 15. FAQ — tabbed categories + accordion -->
    <% const faqCategories = { process: 'Process', working: 'Working Together', pricing: 'Pricing & Support' };
       const faqData = {
         process: [
           { q: 'What does your process look like?', a: 'Five clear stages — Discovery, Strategy, Design, Build, and Launch. You always know what phase we\'re in, what\'s next, and what we need from you. No black boxes, no surprises.' },
           { q: 'How long does a project typically take?', a: 'Most projects land between 3 and 8 weeks depending on scope. A focused landing page is fast; a full brand and site build takes longer. We\'ll give you a realistic timeline before we start.' },
           { q: 'Will I see the work as it progresses?', a: 'Yes. We share progress at every stage and review together before moving on, so there are never any surprises at the end.' }
         ],
         working: [
           { q: 'Do you work with international clients?', a: 'Absolutely. We\'re remote-first and already work across multiple countries and time zones. Async-friendly communication keeps everything smooth no matter where you are.' },
           { q: 'What do you need from me to get started?', a: 'A clear sense of your goals, any existing brand assets, and a point of contact who can give feedback. We handle the rest and guide you through anything we still need.' },
           { q: 'Who will I be working with?', a: 'You work directly with the founder and the small, senior team actually building your project — no account managers, no handoffs.' }
         ],
         pricing: [
           { q: 'How does pricing work?', a: 'Every project is quoted up front based on scope, so you know the full investment before we begin. No hourly surprises.' },
           { q: 'Do you offer post-launch support?', a: 'Yes. Launch is a milestone, not the finish line. We monitor, refine, and offer ongoing support so your project keeps performing after go-live.' },
           { q: 'Do you offer ongoing retainers?', a: 'Many clients keep us on a monthly retainer for continued design, development, and growth work once the initial project ships.' }
         ]
       }; %>
    <section class="faqx" id="faq" aria-label="Frequently asked questions">
      <div class="container faqx__inner">
        <div class="faqx__head">
          <span class="faqx__eyebrow reveal">Let’s answer some questions</span>
          <h2 class="faqx__title reveal">Frequently Asked Questions</h2>
        </div>

        <div class="faqx__tabs reveal" role="tablist" aria-label="FAQ categories">
          <% Object.entries(faqCategories).forEach(function (entry, i) { const key = entry[0], label = entry[1]; %>
          <button class="faqx__tab<%= i === 0 ? ' is-active' : '' %>" role="tab"
                  aria-selected="<%= i === 0 ? 'true' : 'false' %>" tabindex="<%= i === 0 ? '0' : '-1' %>"
                  data-tab="<%= key %>" id="faqtab-<%= key %>" aria-controls="faqpanel-<%= key %>">
            <span><%= label %></span>
          </button>
          <% }); %>
        </div>

        <div class="faqx__panels">
          <% Object.entries(faqData).forEach(function (entry, ci) { const key = entry[0], items = entry[1]; %>
          <div class="faqx__panel<%= ci === 0 ? ' is-active' : '' %>" role="tabpanel"
               id="faqpanel-<%= key %>" aria-labelledby="faqtab-<%= key %>" data-panel="<%= key %>" <%= ci === 0 ? '' : 'hidden' %>>
            <% items.forEach(function (f, i) { %>
            <div class="faqx__item">
              <button class="faqx__q" aria-expanded="false" aria-controls="fa-<%= key %>-<%= i %>" id="fq-<%= key %>-<%= i %>">
                <span><%= f.q %></span>
                <span class="faqx__icon" aria-hidden="true"></span>
              </button>
              <div class="faqx__a" id="fa-<%= key %>-<%= i %>" role="region" aria-labelledby="fq-<%= key %>-<%= i %>">
                <p><%= f.a %></p>
              </div>
            </div>
            <% }); %>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- 16. Contact -->
    <section class="contact" id="contact">
      <div class="container contact__inner">
        <div class="contact__intro">
          <span class="contact__slots reveal"><span class="contact__slots-dot" aria-hidden="true"></span> Taking 2 new projects this month</span>
          <span class="section-label reveal">Start here</span>
          <h2 class="section-heading reveal">Let's talk.</h2>
          <p class="contact__sub reveal">
            Not ready for a full brief? <strong>Send me your site and I'll record a free 3-minute teardown</strong> — no pitch, no obligation. Or book a quick call and we'll map it out together.
          </p>
          <div class="contact__cta-row reveal">
            <a class="btn btn--sweep" href="<%= (typeof site !== 'undefined' && site.bookingUrl) ? site.bookingUrl : '#contactForm' %>" data-book-call>
              Book a 15-min call <span aria-hidden="true">→</span>
            </a>
            <a class="contact__teardown" href="mailto:<%= site.email %>?subject=Free%20teardown%20request&body=Here's%20my%20site%3A%20">
              Get a free teardown <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="contact__or reveal">Prefer to send the details? Fill in the brief below.</p>
        </div>

        <form class="contact__form reveal" id="contactForm" novalidate>
          <div class="field">
            <label for="fullName">Full Name *</label>
            <input type="text" id="fullName" name="fullName" required autocomplete="name" />
            <span class="field__error" data-error-for="fullName"></span>
          </div>
          <div class="field">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
            <span class="field__error" data-error-for="email"></span>
          </div>
          <div class="field">
            <label for="company">Company / Brand</label>
            <input type="text" id="company" name="company" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="website">Company Website</label>
            <input type="text" id="website" name="website" autocomplete="url" placeholder="https://" />
          </div>
          <div class="field">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="service">Service Interested In</label>
            <select id="service" name="service">
              <option value="">Select a service</option>
              <option>Website Design &amp; Development</option>
              <option>SEO</option>
              <option>Website + SEO</option>
              <option>Other</option>
            </select>
            <span class="field__error" data-error-for="service"></span>
          </div>
          <div class="field">
            <label for="budget">Estimated Budget</label>
            <select id="budget" name="budget">
              <option value="">Select a budget</option>
              <option>Under $1K</option>
              <option>$1K–$3K</option>
              <option>$3K–$5K</option>
              <option>$5K–$10K</option>
              <option>$10K+</option>
              <option>Not sure yet</option>
            </select>
            <span class="field__error" data-error-for="budget"></span>
          </div>
          <div class="field field--full">
            <label for="description">Project Description</label>
            <textarea id="description" name="description" rows="5"></textarea>
          </div>

          <div class="field field--full field--consent">
            <label class="consent" for="consent">
              <input type="checkbox" id="consent" name="consent" required />
              <span>I agree to the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> and consent to ONYX storing these details to respond to my enquiry.</span>
            </label>
            <span class="field__error" data-error-for="consent"></span>
          </div>

          <p class="contact__note">We only use your details to reply — no marketing, no sharing.</p>
          <button type="submit" class="btn btn--sweep contact__submit" id="contactSubmit">
            Send Dispatch <span aria-hidden="true">→</span>
          </button>
          <p class="contact__status" id="contactStatus" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <!-- GSAP + ScrollTrigger + Lenis via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js" defer></script>

  <script src="/js/preloader.js" defer></script>
  <script src="/js/blackhole.js" defer></script>
  <script src="/js/main.js" defer></script>
  <script src="/js/gsap-init.js" defer></script>
  <script src="/js/form.js" defer></script>
  <script src="/js/auralis.js" defer></script>
  <script src="/js/footer.js" defer></script>
  <script src="/js/textblock.js" defer></script>
  <script src="/js/stickysvc.js" defer></script>
  <script src="/js/imgreveal.js" defer></script>
  <script src="/js/bento.js" defer></script>
  <script src="/js/hproc.js" defer></script>
  <script src="/js/workswheel.js" defer></script>
  <script src="/js/hero.js" defer></script>
  <script src="/js/portal.js" defer></script>
  <script src="/js/faq.js" defer></script>
</body>
</html>
