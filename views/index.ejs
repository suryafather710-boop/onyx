<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="is-loading">
  <a class="skip" href="#manifesto">Skip to content</a>

  <!-- ============ PRELOADER ============ -->
  <div class="preloader" id="preloader" aria-hidden="true">
    <div class="preloader__inner">
      <svg class="preloader__mark" viewBox="0 0 64 64" fill="none">
        <path d="M32 4 58 32 32 60 6 32Z" stroke="currentColor" stroke-width="1.5"/>
        <path d="M32 16 46 32 32 48 18 32Z" fill="currentColor"/>
      </svg>
      <div class="preloader__brand">ONYX</div>
      <div class="preloader__line mono" data-scramble-loop>Entering the field…</div>
      <div class="preloader__bar"><span id="preloaderBar"></span></div>
      <div class="preloader__pct mono"><span id="preloaderPct">000</span>%</div>
    </div>
  </div>

  <!-- ============ FIELD ============ -->
  <canvas id="field" class="field" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <!-- Labels pinned to points in the 3D field (positioned by field.js) -->
  <div class="hotspots mono" aria-hidden="true">
    <span class="hotspot" data-hotspot="0"><i></i>Brand</span>
    <span class="hotspot" data-hotspot="0"><i></i>Web</span>
    <span class="hotspot" data-hotspot="2"><i></i>Identity</span>
    <span class="hotspot" data-hotspot="2"><i></i>Websites</span>
    <span class="hotspot" data-hotspot="2"><i></i>Interfaces</span>
    <span class="hotspot" data-hotspot="2"><i></i>Growth</span>
    <span class="hotspot" data-hotspot="3"><i></i>Minimal luxury</span>
    <span class="hotspot" data-hotspot="3"><i></i>Mobile-first</span>
    <span class="hotspot" data-hotspot="5"><i></i>Clarity</span>
  </div>

  <div class="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"></span></div>

  <!-- ============ HEADER ============ -->
  <header class="nav" id="nav">
    <a href="#top" class="nav__logo" data-magnetic aria-label="ONYX — back to top">
      <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
        <path d="M32 4 58 32 32 60 6 32Z" stroke="currentColor" stroke-width="3"/>
        <path d="M32 18 45 32 32 46 19 32Z" fill="currentColor"/>
      </svg>
      <span>ONYX</span>
    </a>

    <nav class="chapters" aria-label="Chapters">
      <ol>
        <li><a href="#top" data-chapter-link="A"><span>A</span><em>Intro</em></a></li>
        <li><a href="#manifesto" data-chapter-link="B"><span>B</span><em>Manifesto</em></a></li>
        <li><a href="#services" data-chapter-link="C"><span>C</span><em>Services</em></a></li>
        <li><a href="#work" data-chapter-link="D"><span>D</span><em>Work</em></a></li>
        <li><a href="#process" data-chapter-link="E"><span>E</span><em>Process</em></a></li>
        <li><a href="#promise" data-chapter-link="F"><span>F</span><em>Promise</em></a></li>
        <li><a href="#faq" data-chapter-link="G"><span>G</span><em>Questions</em></a></li>
        <li><a href="#contact" data-chapter-link="H"><span>H</span><em>Contact</em></a></li>
      </ol>
    </nav>

    <div class="nav__right">
      <a href="#contact" class="nav__cta mono" data-magnetic>Start a project</a>
      <button class="nav__menu mono" id="burger" aria-expanded="false" aria-controls="menu">
        <span>Menu</span><span class="nav__chip" id="navChip" aria-hidden="true">A</span>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" aria-hidden="true">
    <ol class="menu__list">
      <li><a href="#top"><span class="mono">A</span>Intro</a></li>
      <li><a href="#manifesto"><span class="mono">B</span>Manifesto</a></li>
      <li><a href="#services"><span class="mono">C</span>Services</a></li>
      <li><a href="#work"><span class="mono">D</span>Work</a></li>
      <li><a href="#process"><span class="mono">E</span>Process</a></li>
      <li><a href="#promise"><span class="mono">F</span>Promise</a></li>
      <li><a href="#faq"><span class="mono">G</span>Questions</a></li>
      <li><a href="#contact"><span class="mono">H</span>Contact</a></li>
    </ol>
    <div class="menu__foot">
      <a class="menu__mail mono" href="mailto:<%= site.email %>"><%= site.email %></a>
      <nav class="menu__legal mono" aria-label="Legal">
        <a href="/privacy">Privacy</a><a href="/cookies">Cookies</a><a href="/terms">Terms</a><a href="/refund-policy">Refunds</a>
      </nav>
    </div>
  </div>

  <div class="rail" aria-hidden="true"><i id="railThumb"></i></div>

  <!-- ============ HUD ============ -->
  <div class="hud mono">
    <div class="hud__left" aria-hidden="true">ONYX — Independent studio · India</div>
    <div class="hud__right">
      <button class="motion" id="motionToggle" aria-pressed="false" aria-label="Pause motion">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12c2.5-6 5-6 7.5 0s5 6 7.5 0 3.5-4 5-2"/></svg>
      </button>
    </div>
  </div>

  <main id="top">
    <!-- ============ A · HERO (pinned statement) ============ -->
    <section class="hero" data-chapter="A" data-shape="0">
      <div class="hero__stage">
        <h1 class="hero__eyebrow mono" data-hero-in><i aria-hidden="true"></i><%= seo.h1 %></h1>

        <p class="statement" id="statement">
          <span class="ln"><span class="sw">We</span> <span class="sw">build</span> <span class="sw">brands</span></span>
          <span class="ln ln--indent"><span class="sw">that</span> <span class="sw sw--accent">lead.</span></span>
        </p>

        <div class="hero__foot">
          <p class="hero__lede" data-hero-in>
            Brand identity, websites and UI/UX for founders who want their brand to look as good
            as their product. Designed and built by one founder-led studio; most projects go live in 2–3 weeks.
          </p>
          <div class="hero__actions" data-hero-in>
            <a href="#contact" class="btn btn--primary" data-magnetic><span>Start a project</span><i aria-hidden="true">→</i></a>
            <a href="#work" class="btn btn--ghost" data-magnetic><span>See our work</span></a>
          </div>
        </div>

        <ul class="hero__proof mono" data-hero-in aria-label="Why ONYX">
          <li>Founder-led</li>
          <li>Fixed-price quotes</li>
          <li>2–3 week delivery</li>
          <li>Recent work: UKEE</li>
        </ul>
      </div>
    </section>

    <!-- ============ MARQUEE ============ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Brand Identity</span><i>✦</i><span>Web Design</span><i>✦</i><span>Development</span><i>✦</i><span>UI / UX</span><i>✦</i><span>SEO &amp; Growth</span><i>✦</i><span>Motion</span><i>✦</i>
        <span>Brand Identity</span><i>✦</i><span>Web Design</span><i>✦</i><span>Development</span><i>✦</i><span>UI / UX</span><i>✦</i><span>SEO &amp; Growth</span><i>✦</i><span>Motion</span><i>✦</i>
      </div>
    </div>

    <!-- ============ B · MANIFESTO ============ -->
    <section class="chapter manifesto" id="manifesto" data-chapter="B" data-shape="1" data-field-dim="0.45" tabindex="-1">
      <div class="intro">
        <span class="chip" aria-hidden="true">B</span>
        <span class="eyebrow mono" data-scramble>The manifesto</span>
      </div>

      <div class="manifesto__block">
        <h2 class="manifesto__text" data-lines>
          Good products deserve<br />brands that are
        </h2>
        <p class="manifesto__rotate" aria-live="off">
          <span class="sr-only">impossible to ignore, built to last, hard to copy and ready to lead.</span>
          <span class="carousel" aria-hidden="true" data-carousel data-interval="2.2"
                data-words='["impossible to ignore.", "built to last.", "hard to copy.", "ready to lead."]'>impossible to ignore.</span>
        </p>
        <p class="manifesto__desc" data-reveal>
          We design the identity, build the website and obsess over every detail ourselves.
          No templates. No hand-offs. No excuses.
        </p>
        <a href="#services" class="btn btn--ghost" data-reveal data-magnetic><span>See what we do</span><i aria-hidden="true">↓</i></a>
      </div>
    </section>

    <!-- ============ C · SERVICES (pinned sequence) ============ -->
    <section class="chapter seq" id="services" data-chapter="C" data-shape="2" data-field-dim="0.6" data-seq style="--n:4" tabindex="-1">
      <div class="seq__stage svc-stage">
        <div class="seq__meta mono">
          <span class="chip" aria-hidden="true">C</span>
          <h2 class="eyebrow" data-scramble>What we do</h2>
          <span class="seq__count" aria-hidden="true"><b data-seq-index>01</b> / 04</span>
          <span class="seq__bar" aria-hidden="true"><i data-seq-bar></i></span>
        </div>

        <ol class="svc-names" aria-label="Services">
          <li data-seq-item>Brand identity</li>
          <li data-seq-item>Websites</li>
          <li data-seq-item>UI / UX</li>
          <li data-seq-item>SEO &amp; Growth</li>
        </ol>

        <div class="svc-details">
          <div class="svc-detail" data-seq-item>
            <span class="mono">/01 — Brand identity</span>
            <p>Naming, logo systems, typography, colour and voice. A brand that looks considered at every size, from favicon to billboard.</p>
            <ul class="pills mono"><li>Logo</li><li>Visual system</li><li>Guidelines</li><li>Voice</li></ul>
          </div>
          <div class="svc-detail" data-seq-item>
            <span class="mono">/02 — Websites</span>
            <p>Animated, fast, hand-built websites. Custom code, WebGL where it earns its place, and a CMS where you need to edit.</p>
            <ul class="pills mono"><li>Node.js</li><li>WebGL</li><li>GSAP</li><li>CMS</li></ul>
          </div>
          <div class="svc-detail" data-seq-item>
            <span class="mono">/03 — UI / UX</span>
            <p>Interfaces for apps and SaaS, built on research with real users. Screens your customers don't have to think about, and a design system your developers can reuse.</p>
            <ul class="pills mono"><li>Research</li><li>Wireframes</li><li>Prototypes</li><li>Design systems</li></ul>
          </div>
          <div class="svc-detail" data-seq-item>
            <span class="mono">/04 — SEO &amp; Growth</span>
            <p>Technical SEO, content and conversion work, so the site you launch keeps finding the people it was built for.</p>
            <ul class="pills mono"><li>Technical SEO</li><li>Content</li><li>CRO</li><li>Analytics</li></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ D · WORK ============ -->
    <section class="chapter work" id="work" data-chapter="D" data-shape="3" data-field-dim="0.5" tabindex="-1">
      <div class="work__inner">
        <div class="work__meta">
          <div class="head">
            <span class="chip" aria-hidden="true">D</span>
            <h2 class="eyebrow mono" data-scramble>Selected work</h2>
          </div>
          <span class="mono work__index" aria-hidden="true">01 / 01</span>
          <h3 class="work__title" data-lines>UKEE</h3>
          <p class="mono work__kind" data-reveal>Haircare · Luxury e-commerce</p>
          <p class="work__desc" data-reveal>
            Minimal by design, luxurious by feel. Velvet reds, quiet gold type and generous
            space let UKEE's serum take centre stage, so visitors are drawn into the brand
            before they ever reach the shop.
          </p>
          <ul class="pills mono" data-reveal><li>Minimal luxury</li><li>Web design</li><li>Development</li><li>Mobile-first</li></ul>
        </div>

        <figure class="work__device">
          <div class="phone" data-phone>
            <img src="/images/work/ukee-mobile.jpg" width="324" height="572" loading="lazy" decoding="async"
                 alt="UKEE website on a phone: a model resting on a red velvet sofa beside the serum bottle, with the headline India's first and a Shop now button." />
          </div>
          <figcaption class="mono">UKEE — mobile home page</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ E · PROCESS (pinned sequence) ============ -->
    <section class="chapter seq" id="process" data-chapter="E" data-seq style="--n:4" tabindex="-1">
      <!-- field shape per phase (see public/js/field.js) -->
      <span class="shape-mark" aria-hidden="true" data-shape="4" data-field-dim="0.4" style="top:0"></span>
      <span class="shape-mark" aria-hidden="true" data-shape="7" data-field-dim="0.4" data-morph="0.28" style="top:calc((100% - 100vh) * 0.25 + 64vh)"></span>
      <span class="shape-mark" aria-hidden="true" data-shape="8" data-field-dim="0.4" data-morph="0.28" style="top:calc((100% - 100vh) * 0.5 + 64vh)"></span>
      <span class="shape-mark" aria-hidden="true" data-shape="9" data-field-dim="0.4" data-morph="0.28" style="top:calc((100% - 100vh) * 0.75 + 64vh)"></span>
      <div class="seq__stage proc-stage">
        <div class="seq__meta mono">
          <span class="chip" aria-hidden="true">E</span>
          <h2 class="eyebrow" data-scramble>How we work</h2>
          <span class="seq__count" aria-hidden="true"><b data-seq-index>01</b> / 04</span>
          <span class="seq__bar" aria-hidden="true"><i data-seq-bar></i></span>
        </div>

        <ol class="proc-steps">
          <li class="proc-step" data-seq-item>
            <span class="proc-step__n" aria-hidden="true">01</span>
            <h3>Discover</h3>
            <span class="mono">Typically days 1–3</span>
            <p>Workshops, audits and a close look at your competitors. We find the one idea worth building around.</p>
          </li>
          <li class="proc-step" data-seq-item>
            <span class="proc-step__n" aria-hidden="true">02</span>
            <h3>Design</h3>
            <span class="mono">Typically weeks 1–2</span>
            <p>Identity and interface explored in parallel and refined with you in live review sessions.</p>
          </li>
          <li class="proc-step" data-seq-item>
            <span class="proc-step__n" aria-hidden="true">03</span>
            <h3>Build</h3>
            <span class="mono">Typically weeks 2–3</span>
            <p>Hand-coded, animated and tested on real phones and laptops, with a performance budget set up front.</p>
          </li>
          <li class="proc-step" data-seq-item>
            <span class="proc-step__n" aria-hidden="true">04</span>
            <h3>Grow</h3>
            <span class="mono">Launch and after</span>
            <p>After launch we look at where visitors drop off and fix it: page speed, search visibility and the steps between landing and enquiring.</p>
          </li>
        </ol>

        <ol class="proc-ticks mono" aria-hidden="true">
          <li data-seq-tick>Discover</li><li data-seq-tick>Design</li><li data-seq-tick>Build</li><li data-seq-tick>Grow</li>
        </ol>
      </div>
    </section>

    <!-- ============ F · PROMISE (inverted light panel) ============ -->
    <section class="promise" id="promise" data-chapter="F" tabindex="-1">
      <div class="promise__inner">
        <span class="chip chip--dark" aria-hidden="true">F</span>
        <h2 class="sr-only">Our promise</h2>
        <p class="promise__text" data-words>
          ONYX is where design, code and <em>modern luxury</em> meet. We build brands for people
          who notice the details, and websites that make everyone else notice them too.
        </p>
        <div class="promise__sign" data-reveal>
          <span class="chip chip--dark" aria-hidden="true">S</span>
          <span><b><%= site.founder %></b><small class="mono">Founder, ONYX</small></span>
        </div>
      </div>
    </section>

    <!-- ============ G · FAQ ============ -->
    <section class="chapter faq" id="faq" data-chapter="G" data-shape="5" data-field-dim="0.5" tabindex="-1">
      <div class="intro">
        <span class="chip" aria-hidden="true">G</span>
        <h2 class="h2" data-lines>Questions,<br />answered</h2>
        <p class="muted" data-reveal>Still curious? Write to <a class="link" href="mailto:<%= site.email %>"><%= site.email %></a></p>
      </div>
      <div class="faq__list">
        <% faq.forEach(function (item, i) { %>
        <details class="qa" data-reveal>
          <summary><span class="mono"><%= String(i + 1).padStart(2, '0') %></span><%= item.q %><i aria-hidden="true"></i></summary>
          <div class="qa__body"><p><%= item.a %></p></div>
        </details>
        <% }) %>
      </div>
    </section>

    <!-- ============ H · CONTACT ============ -->
    <section class="chapter contact" id="contact" data-chapter="H" data-shape="6" data-field-dim="0.35" tabindex="-1">
      <div class="contact__intro">
        <div class="head">
          <span class="chip" aria-hidden="true">H</span>
          <span class="eyebrow mono" data-scramble>Start a project</span>
        </div>
        <h2 class="h2" data-lines>Bring the<br />rough stone.<br /><em>We'll cut it.</em></h2>
        <p class="muted" data-reveal>Tell us what you're building. We usually reply within one business day, often with an invitation to a short call.</p>
        <div class="contact__direct" data-reveal>
          <a class="link mono" href="mailto:<%= site.email %>"><%= site.email %></a>
        </div>
      </div>

      <form class="form" id="contactForm" novalidate data-reveal>
        <div class="field-row">
          <label class="fld">
            <span class="mono">Your name</span>
            <input type="text" name="name" autocomplete="name" required maxlength="80" aria-describedby="err-name" />
            <small class="err" id="err-name" data-err="name"></small>
          </label>
          <label class="fld">
            <span class="mono">Email</span>
            <input type="email" name="email" autocomplete="email" required maxlength="120" aria-describedby="err-email" />
            <small class="err" id="err-email" data-err="email"></small>
          </label>
        </div>

        <fieldset class="choices">
          <legend class="mono">I need</legend>
          <label><input type="radio" name="service" value="Brand identity" /><span>Brand identity</span></label>
          <label><input type="radio" name="service" value="Website" checked /><span>Website</span></label>
          <label><input type="radio" name="service" value="UI/UX" /><span>UI / UX</span></label>
          <label><input type="radio" name="service" value="SEO & growth" /><span>SEO &amp; growth</span></label>
        </fieldset>

        <fieldset class="choices budget" data-budget>
          <legend class="mono">Budget</legend>
          <div class="currency" role="radiogroup" aria-label="Currency">
            <label><input type="radio" name="currency" value="INR" checked /><span>₹ INR</span></label>
            <label><input type="radio" name="currency" value="USD" /><span>$ USD</span></label>
          </div>
          <div class="budget__set" data-currency="INR">
            <label><input type="radio" name="budget" value="Under ₹10k" /><span>Under ₹10k</span></label>
            <label><input type="radio" name="budget" value="₹10k–20k" checked /><span>₹10k–20k</span></label>
            <label><input type="radio" name="budget" value="₹20k–30k" /><span>₹20k–30k</span></label>
            <label><input type="radio" name="budget" value="₹30k+" /><span>₹30k+</span></label>
          </div>
          <div class="budget__set" data-currency="USD">
            <label><input type="radio" name="budget" value="Under $2k" /><span>Under $2k</span></label>
            <label><input type="radio" name="budget" value="$2k–5k" /><span>$2k–5k</span></label>
            <label><input type="radio" name="budget" value="$5k–15k" /><span>$5k–15k</span></label>
            <label><input type="radio" name="budget" value="$15k+" /><span>$15k+</span></label>
          </div>
        </fieldset>

        <label class="fld">
          <span class="mono">About the project</span>
          <textarea name="message" rows="4" required maxlength="2000" aria-describedby="err-message" placeholder="Goals, timeline, links you love…"></textarea>
          <small class="err" id="err-message" data-err="message"></small>
        </label>

        <div aria-hidden="true"><input type="text" name="company_site" class="hp" tabindex="-1" autocomplete="off" /></div>

        <% if (turnstileKey) { %>
        <div class="captcha">
          <div data-turnstile data-sitekey="<%= turnstileKey %>"></div>
          <small class="err" data-err="captcha"></small>
        </div>
        <% } %>

        <label class="consent">
          <input type="checkbox" name="consent" required aria-describedby="err-consent" />
          <span>I am 18 or older and agree that ONYX may store these details to reply to my enquiry, as described in the <a class="link" href="/privacy">Privacy Policy</a>. I can withdraw consent at any time by emailing <%= site.email %>.</span>
        </label>
        <small class="err" id="err-consent" data-err="consent"></small>

        <button type="submit" class="btn btn--primary btn--big" data-magnetic>
          <span class="btn__label">Send project enquiry</span><i aria-hidden="true">→</i>
        </button>
        <p class="form__status mono" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <!-- ============ THANK-YOU ============ -->
  <dialog class="thanks" id="thanks" aria-labelledby="thanksTitle" aria-describedby="thanksText">
    <span class="thanks__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </span>
    <p class="mono thanks__eyebrow">Enquiry received</p>
    <h2 class="thanks__title" id="thanksTitle">Thank you<span data-thanks-name></span>.</h2>
    <p class="thanks__text" id="thanksText">
      Your project is with us. We usually reply within one business day from
      <b><%= site.email %></b>, so keep an eye on your inbox (and spam folder, just in case).
    </p>
    <div class="thanks__actions">
      <button type="button" class="btn btn--primary" data-thanks-close><span>Back to the site</span></button>
      <a href="#work" class="btn btn--ghost" data-thanks-close><span>See our work</span></a>
    </div>
  </dialog>

  <!-- ============ FOOTER ============ -->
  <%- include('partials/footer') %>

  <noscript><style>.preloader{display:none}body.is-loading{overflow:auto}[data-reveal],[data-hero-in],.statement .sw,.w{opacity:1!important;transform:none!important;filter:none!important}.seq{height:auto}.seq__stage{position:relative;height:auto}.svc-detail,.proc-step{position:relative;opacity:1;transform:none}.proc-steps{display:grid;gap:40px}</style></noscript>

  <script src="/vendor/gsap/gsap.min.js"></script>
  <script src="/vendor/gsap/ScrollTrigger.min.js"></script>
  <script src="/vendor/lenis/lenis.min.js"></script>
  <script src="/js/app.js?v=<%= v %>" defer></script>
  <script type="module" src="/js/field.js?v=<%= v %>"></script>
</body>
</html>
