<!-- Preloader: full-screen overlay with animated percentage counter -->
<div class="preloader" id="preloader" aria-hidden="true">
  <div class="preloader__inner">
    <span class="preloader__mark">ONYX</span>
    <span class="preloader__count" id="preloaderCount">0%</span>
  </div>
  <div class="preloader__bar"><span class="preloader__bar-fill" id="preloaderBar"></span></div>
</div>
