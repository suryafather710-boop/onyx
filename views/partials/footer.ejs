<footer class="footer">
  <div class="footer__top">
    <div>
      <span class="mono muted">Say hello</span>
      <a href="mailto:<%= site.email %>" class="footer__mail"><%= site.email %></a>
    </div>
    <nav class="footer__legal mono" aria-label="Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/cookies">Cookie Policy</a>
      <a href="/terms">Terms &amp; Conditions</a>
      <a href="/refund-policy">Refund Policy</a>
    </nav>
  </div>
  <div class="footer__word" aria-hidden="true"><span>O</span><span>N</span><span>Y</span><span>X</span></div>
  <div class="footer__bottom mono">
    <span>© <%= site.year %> <%= biz.legalName || 'ONYX' %>. All rights reserved.</span>
    <% if (biz.address) { %><span><%= biz.address %></span><% } %>
    <% if (biz.gstin) { %><span>GSTIN <%= biz.gstin %></span><% } %>
    <% if (biz.cin) { %><span>CIN <%= biz.cin %></span><% } %>
    <a href="#top" class="to-top">Back to top ↑</a>
  </div>
</footer>
