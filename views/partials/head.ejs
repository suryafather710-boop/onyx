<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<% var meta = (typeof seo !== 'undefined' && seo) ? seo : {}; %>
<% var fullTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : (meta.title || site.name + ' — ' + site.tagline); %>
<title><%= fullTitle %></title>
<% var desc = (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : (meta.description || site.description); %>
<meta name="description" content="<%= desc %>" />
<% if (meta.keywords) { %><meta name="keywords" content="<%= meta.keywords.join(', ') %>" /><% } %>
<meta name="theme-color" content="#0c0c0e" />
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex" /><% } else { %><link rel="canonical" href="<%= site.url %><%= path %>" /><% } %>
<meta property="og:type" content="website" />
<meta property="og:title" content="<%= fullTitle %>" />
<meta property="og:description" content="<%= desc %>" />
<meta property="og:url" content="<%= site.url %><%= path %>" />
<meta property="og:site_name" content="ONYX" />
<meta property="og:locale" content="en_IN" />
<meta property="og:image" content="<%= site.url %>/images/og-cover.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="ONYX — We build brands that lead." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="<%= site.url %>/images/og-cover.png" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="stylesheet" href="/css/fonts.css?v=<%= v %>" />
<link rel="stylesheet" href="/css/style.css?v=<%= v %>" />
<% if (typeof jsonld !== 'undefined' && jsonld) { %><script type="application/ld+json"><%- jsonld %></script><% } %>
