<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <meta name="robots" content="index,follow" />
</head>
<body class="legal-body" id="top">
  <a class="skip" href="#doc">Skip to content</a>

  <header class="nav nav--static">
    <a href="/" class="nav__logo" aria-label="ONYX — home">
      <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
        <path d="M32 4 58 32 32 60 6 32Z" stroke="currentColor" stroke-width="3"/>
        <path d="M32 18 45 32 32 46 19 32Z" fill="currentColor"/>
      </svg>
      <span>ONYX</span>
    </a>
    <div class="nav__right">
      <a href="/#contact" class="nav__cta mono">Start a project</a>
    </div>
  </header>

  <main class="legal" id="doc" tabindex="-1">
    <aside class="legal__nav">
      <span class="mono muted">Legal</span>
      <nav aria-label="Legal documents">
        <ul>
          <% Object.entries(legalPages).forEach(function ([slug, label]) { %>
            <li><a href="/<%= slug %>" class="mono" <% if (slug === doc) { %>aria-current="page"<% } %>><%= label %></a></li>
          <% }) %>
        </ul>
      </nav>
    </aside>

    <article class="legal__doc">
      <p class="mono muted">Last updated <%= biz.legalUpdated %></p>
      <h1><%= title %></h1>
      <%- include('legal/' + doc) %>

      <section class="legal__who">
        <h2>Who we are</h2>
        <ul class="legal__facts">
          <li><b>Business</b><span><%= need(biz.legalName, 'legal name') %>, trading as ONYX</span></li>
          <li><b>Type</b><span><%= need(biz.entityType, 'business type') %></span></li>
          <li><b>Address</b><span><%= need(biz.address, 'postal address') %></span></li>
          <li><b>Email</b><span><a class="link" href="mailto:<%= biz.email %>"><%= biz.email %></a></span></li>
          <% if (biz.phone) { %><li><b>Phone</b><span><%= biz.phone %></span></li><% } %>
          <% if (biz.gstin) { %><li><b>GSTIN</b><span><%= biz.gstin %></span></li><% } %>
          <% if (biz.cin) { %><li><b>CIN / LLPIN</b><span><%= biz.cin %></span></li><% } %>
        </ul>
      </section>

      <nav class="legal__next" aria-label="Continue">
        <a href="/#contact"><span class="mono">Questions about this?</span>Contact us<i aria-hidden="true">→</i></a>
        <a href="/#work"><span class="mono">See what we make</span>Our work<i aria-hidden="true">→</i></a>
        <a href="/"><span class="mono">Back to</span>Home<i aria-hidden="true">→</i></a>
      </nav>
    </article>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
