PORT=3000
NODE_ENV=production
SITE_URL=https://getonyx.pro
CONTACT_EMAIL=suryafather@gmail.com
# Optional: Cal.com / Calendly link for the "Book a call" button
BOOKING_URL=

# --- Business details for the legal pages (see config/business.js) ---
LEGAL_NAME=
ENTITY_TYPE=
BUSINESS_ADDRESS=
JURISDICTION_CITY=
BUSINESS_PHONE=
GSTIN=
CIN=
PRIVACY_CONTACT_NAME=Suryanshu Bhattacharya
PRIVACY_EMAIL=

# --- Email alert for every new enquiry (Hostinger email: smtp.hostinger.com, port 465) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where alerts go (defaults to CONTACT_EMAIL)
NOTIFY_EMAIL=

# Proxy hops in front of the app: 1 on Hostinger, 2 with Cloudflare in front, 0 if exposed directly
TRUST_PROXY=1

# --- Cloudflare Turnstile spam check (dash.cloudflare.com -> Turnstile -> Add site) ---
# For local testing Cloudflare provides always-pass keys:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
